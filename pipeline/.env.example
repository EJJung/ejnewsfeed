# Copy to .env and fill in your values

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Supabase
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Gmail OAuth — Web application client (Cloud Console → OAuth 2.0 → Web application)
# Used by Supabase Edge Functions (set via `supabase secrets set`).
# Keep these here as a reference; do NOT use these values for local --auth.
GMAIL_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-web-client-secret

# Gmail OAuth — Desktop app client (Cloud Console → OAuth 2.0 → Desktop app)
# Used by gmail_fetch.py --auth for local development.
# No redirect URI registration required in Cloud Console.
GMAIL_LOCAL_CLIENT_ID=your-desktop-client-id.apps.googleusercontent.com
GMAIL_LOCAL_CLIENT_SECRET=your-desktop-client-secret

# Path to the token file saved after first OAuth flow
GMAIL_TOKEN_PATH=./gmail_token.json
# The dedicated newsletter Gmail address
GMAIL_ADDRESS=ej.newsfeed@gmail.com
